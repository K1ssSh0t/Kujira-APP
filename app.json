{
    "expo": {
        "name": "Kujira-APP",
        "slug": "Kujira-APP",
        "version": "1.2.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "kujira-app",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/images/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#2F0C50"
        },
        "assetBundlePatterns": ["**/*"],
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#2F0C50"
            }
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": ["expo-router", "expo-video", "expo-web-browser"],
        "experiments": {
            "typedRoutes": true
        }
    }
}
